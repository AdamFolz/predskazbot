# Speed / quality tuning – вставь в Amvera → Переменные (поверх существующих)
# Уменьшаем контекст – ответ в 2-3 раза быстрее
MAX_RECENT_MESSAGES=30
MAX_RECENT_BOT_RESPONSES=20
REGENERATION_ATTEMPTS=1
FUTURE_COOLDOWN_SECONDS=12
SUMMARY_COOLDOWN_SECONDS=30
ASK_COOLDOWN_SECONDS=8
KB_SEARCH_LIMIT=3

# Быстрая модель (если j3gb тормозит на gpt-5.5)
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_MODEL=qwen3-235b-a22b
# оставь gpt-5.5 если он у тебя уже работает

# остальное без изменений – скопируй из твоего рабочего .env
